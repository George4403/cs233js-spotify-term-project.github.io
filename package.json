    "css-loader": "^6.7.1",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "jest-fetch-mock": "^3.0.3",
    "jsdoc": "^4.0.5",
    "sass": "^1.54.9",
